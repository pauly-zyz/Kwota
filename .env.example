# ───────────────────────── API (apps/api) ─────────────────────────
# Never commit real values. Copy to apps/api/.env (or export) for local use.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://kwota:kwota@localhost:5432/kwota
# Optional: without REDIS_URL an in-memory store is used (single process only)
REDIS_URL=redis://localhost:6379
# >= 16 random chars; REQUIRED in production
SESSION_SECRET=
# Comma-separated web origins allowed to call the API (also used as SIWE domains)
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8787

# Chain — Robinhood Chain testnet 46630 / mainnet 4663.
# Empty RPC_URL / EXPLORER_URL / BLOCKSCOUT_API_URL fall back to the official public endpoints
# (docs.robinhood.com/chain/connecting):
#   testnet: https://rpc.testnet.chain.robinhood.com · https://explorer.testnet.chain.robinhood.com
#   mainnet: https://rpc.mainnet.chain.robinhood.com · https://robinhoodchain.blockscout.com
# The public RPC is rate-limited — use an Alchemy/Chainstack/QuickNode endpoint in production.
CHAIN_ID=46630
RPC_URL=
EXPLORER_URL=
BLOCKSCOUT_API_URL=
CONFIRMATIONS=10
INDEXER_START_BLOCK=0
INDEXER_BATCH_BLOCKS=2000

# Addresses (public, not secrets). Fill after launch on Pons.
KWOTA_TOKEN_ADDRESS=
# Dev wallet that receives trading fees directly (= treasury)
TREASURY_ADDRESS=
POOL_WALLET_ADDRESS=
VAULT_ADDRESS=
OPS_WALLET_ADDRESS=
# Comma-separated
LP_PAIR_ADDRESSES=
PROTOCOL_ADDRESSES=
ANT_ADDRESS=0xbbb6c29bcc3a1028a2b54310df73f4f7a3bcb373
# USDG etc. — official addresses only. docs.robinhood.com/chain/contracts lists
# USDG = 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168 (network not stated on that page —
# confirm on the explorer for your CHAIN_ID before setting it)
STABLE_TOKEN_ADDRESSES=
# Tokens whose transfers into the treasury count as fee inflows (e.g. ANT, KWOTA, WETH, USDG)
TRACKED_FEE_TOKENS=
# Admin wallets (sign admin actions in the browser; keys never on the server)
ADMIN_ADDRESSES=

# Epochs
# Unix time of epoch #1 start (0 = start of the current UTC day/period)
EPOCH_GENESIS_TIME=0
# true = worker publishes epochs automatically; false = admin publishes from dashboard
AUTO_PUBLISH_EPOCHS=false

# Model provider: "mock" (offline dev), "openai_compatible" (e.g. Surplus Intelligence) or "openrouter"
MODEL_PROVIDER=mock
PROVIDER_ID=surplus
PROVIDER_BASE_URL=https://api.surplusintelligence.ai/v1
# Secret — server env only
PROVIDER_API_KEY=
# Optional: comma-separated provider model ids to import (default: curated list in seedLib.ts)
SEED_MODELS=
# Single-service hosting: run indexer + epoch worker inside the API process
RUN_INDEXER=false
RUN_WORKER=false
# Seed models/registries on API start
AUTO_SEED=false
# Testnet only: admin may credit/debit tester kwota (signed + audited)
ALLOW_ADMIN_ADJUST=false
# Secret — set only in the server environment, never in git
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=KWOTA

# ERC-8004 registry (seeded by `pnpm --filter @kwota/api seed`)
AGENT_REGISTRY_ADDRESS=
AGENT_REGISTRY_NAME=Agent Mint Registry
# Dev only: static registry JSON {"0xRegistry":{"1":{"owner":"0x…","wallet":"0x…"}}}
AGENT_REGISTRY_MOCK=

# ───────────────────────── Web (apps/web) ─────────────────────────
# Set these in Vercel → Project → Environment Variables
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_KWOTA_TOKEN_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_PONS_URL=
NEXT_PUBLIC_DEXSCREENER_URL=
NEXT_PUBLIC_X_URL=
